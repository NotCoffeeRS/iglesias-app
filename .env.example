# Configurar DATABASE_URL en el entorno antes de iniciar el backend.
# PostgreSQL usa el dialecto postgresql+psycopg y los datos de conexión de tu entorno.
# Sin DATABASE_URL se usa SQLite en memoria, solo para desarrollo y pruebas.
# No se crean tablas ni se aplican migraciones al arrancar.
DATABASE_URL=sqlite+pysqlite:///:memory:
# Este archivo es una referencia: no se carga automáticamente.
